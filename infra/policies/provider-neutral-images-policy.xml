<policies>
  <inbound>
    <set-variable name="selectedModelKnown" value="@(false)" />
    <base />
    <return-response>
      <set-status code="400" reason="Bad Request" />
      <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
      <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
      <set-body>{"error":{"type":"invalid_request_error","code":"image_model_not_published","message":"No image model is published by this gateway revision"}}</set-body>
    </return-response>
  </inbound>
  <backend><base /></backend>
  <outbound><base /></outbound>
  <on-error><base /></on-error>
</policies>